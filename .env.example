# Copy to .env and adjust if your local Postgres differs.
#
# The project ships a docker-compose.yml that provides exactly this database:
#   docker compose up -d
#
# Any local PostgreSQL works. Point DATABASE_URL at it and the project does
# not care how it is running.

DATABASE_URL="postgresql://declutter:declutter@localhost:5432/declutter?schema=public"

# A separate database, wiped between test runs. Never point this at the
# development database: the test suite truncates tables.
TEST_DATABASE_URL="postgresql://declutter:declutter@localhost:5432/declutter_test?schema=public"

# Any non-empty value works locally. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
